! Zone 4A approximate values for Dulles VA
! =============================================================================

  Site:GroundTemperature:BuildingSurface,
    12.8,                    !- January {C}
    11.1,                    !- February
    11.7,                    !- March
    13.3,                    !- April
    15.6,                    !- May
    18.3,                    !- June
    20.6,                    !- July
    21.7,                    !- August
    21.1,                    !- September
    19.4,                    !- October
    16.1,                    !- November
    13.9;                    !- December

! =============================================================================
! ZONES
! =============================================================================

  Zone,
    OFFICE,                  !- Name
    0.0,                     !- Direction of Relative North {deg}
    0.0, 0.0, 0.0,           !- Origin X, Y, Z {m}
    1,                       !- Type
    1,                       !- Multiplier
    3.048,                   !- Ceiling Height {m} — 10 ft
    2265.45;                 !- Volume {m3} = 743.22 m2 × 3.048 m

  Zone,
    LOBBY,                   !- Name
    0.0,                     !- Direction of Relative North {deg}
    0.0, 0.0, 0.0,           !- Origin X, Y, Z {m}
    1,                       !- Type
    1,                       !- Multiplier
    3.048,                   !- Ceiling Height {m}
    1133.61;                 !- Volume {m3} = 371.61 m2 × 3.048 m

