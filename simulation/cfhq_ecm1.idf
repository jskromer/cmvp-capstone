! =============================================================================
! Counterfactual Headquarters — Baseline IDF
! =============================================================================
! Building:  12,000 sf (1,115 m²) single-story municipal office
! Location:  Washington Dulles, VA — Zone 4A
! Zones:     OFFICE (8,000 sf / 743 m²)  +  LOBBY (4,000 sf / 372 m²)
! HVAC:      Packaged RTU per zone — gas furnace, DX cooling
! Baseline:  T8 fluorescents (1.5 W/sf office, 1.0 W/sf lobby)
!            Original RTU controls — fixed setpoints, no scheduling optimization
! ECMs:      ECM-1: LED retrofit (office wing only)
!            ECM-2: DDC controls — optimized setpoints and scheduling
! Weather:   USA_VA_Sterling-Washington.Dulles.Intl.AP.724030_TMY3.epw
! EnergyPlus Version: 25.1
! Author: Counterfactual Designs / Steve Kromer PE CMVP
! =============================================================================

  Version,25.2;

! =============================================================================
! SIMULATION CONTROL
! =============================================================================

  SimulationControl,
    YES,                     !- Do Zone Sizing Calculation
    YES,                     !- Do System Sizing Calculation
    YES,                     !- Do Plant Sizing Calculation
    YES,                     !- Run Simulation for Sizing Periods
    YES,                     !- Run Simulation for Weather File Run Periods
    No,                      !- Do HVAC Sizing Simulation for Sizing Periods
    1;                       !- Maximum Number of HVAC Sizing Simulation Passes

  GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    CounterClockWise,        !- Vertex Entry Direction
    Relative,                !- Coordinate System
    Relative,                !- Daylighting Reference Point Coordinate System
    Relative;                !- Rectangular Surface Coordinate System

  Building,
    Counterfactual Headquarters,  !- Name
    0.0,                     !- North Axis {deg} — long axis E-W
    City,                    !- Terrain
    0.0400,                  !- Loads Convergence Tolerance Value {W}
    0.2000,                  !- Temperature Convergence Tolerance Value {deltaC}
    FullInteriorAndExterior, !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

  RunPeriod,
    Annual,                  !- Name
    1,                       !- Begin Month
    1,                       !- Begin Day of Month
    ,                        !- Begin Year
    12,                      !- End Month
    31,                      !- End Day of Month
    ,                        !- End Year
    Sunday,                  !- Day of Week for Start Day
    No,                      !- Use Weather File Holidays and Special Days
    No,                      !- Use Weather File Daylight Saving Period
    Yes,                     !- Apply Weekend Holiday Rule
    Yes,                     !- Use Weather File Rain Indicators
    Yes;                     !- Use Weather File Snow Indicators

  RunPeriodControl:DaylightSavingTime,
    2nd Sunday in March,     !- StartDate
    2nd Sunday in November;  !- EndDate

! =============================================================================
! LOCATION AND DESIGN DAYS — Washington Dulles, VA (Zone 4A)
! =============================================================================

  Site:Location,
    Washington Dulles Intl Airport VA,  !- Name
    38.98,                   !- Latitude {N+ S-}
    -77.47,                  !- Longitude {W- E+}
    -5.00,                   !- Time Zone {GMT+/-}
    82.00;                   !- Elevation {m}

  ! Winter design day — 99.6% heating
  SizingPeriod:DesignDay,
    Dulles Ann Htg 99.6% Condns DB,  !- Name
    1,                       !- Month
    21,                      !- Day of Month
    WinterDesignDay,         !- Day Type
    -11.8,                   !- Maximum Dry-Bulb Temperature {C}
    0.0,                     !- Daily Dry-Bulb Temperature Range {C}
    DefaultMultipliers,      !- Dry-Bulb Temperature Range Modifier Type
    ,                        !- Dry-Bulb Temperature Range Modifier Schedule Name
    Wetbulb,                 !- Humidity Condition Type
    -11.8,                   !- Wetbulb at Maximum Dry-Bulb {C}
    ,                        !- Humidity Indicating Day Schedule Name
    ,                        !- Humidity Ratio at Maximum Dry-Bulb
    ,                        !- Enthalpy at Maximum Dry-Bulb
    ,                        !- Daily Wet-Bulb Temperature Range
    100344.,                 !- Barometric Pressure {Pa}
    2.7,                     !- Wind Speed {m/s}
    310,                     !- Wind Direction {deg}
    No,                      !- Rain
    No,                      !- Snow on ground
    No,                      !- Daylight Savings Time Indicator
    ASHRAEClearSky,          !- Solar Model Indicator
    ,                        !- Beam Solar Day Schedule Name
    ,                        !- Diffuse Solar Day Schedule Name
    ,                        !- taub
    ,                        !- taud
    0.00;                    !- Clearness

  ! Summer design day — 1% cooling
  SizingPeriod:DesignDay,
    Dulles Ann Clg 1% Condns DB=>MWB,  !- Name
    7,                       !- Month
    21,                      !- Day of Month
    SummerDesignDay,         !- Day Type
    32.7,                    !- Maximum Dry-Bulb Temperature {C}
    11.4,                    !- Daily Dry-Bulb Temperature Range {C}
    DefaultMultipliers,      !- Dry-Bulb Temperature Range Modifier Type
    ,                        !- Dry-Bulb Temperature Range Modifier Schedule Name
    Wetbulb,                 !- Humidity Condition Type
    23.5,                    !- Wetbulb at Maximum Dry-Bulb {C}
    ,                        !- Humidity Indicating Day Schedule Name
    ,                        !- Humidity Ratio at Maximum Dry-Bulb
    ,                        !- Enthalpy at Maximum Dry-Bulb
    ,                        !- Daily Wet-Bulb Temperature Range
    100344.,                 !- Barometric Pressure {Pa}
    4.0,                     !- Wind Speed {m/s}
    290,                     !- Wind Direction {deg}
    No,                      !- Rain
    No,                      !- Snow on ground
    No,                      !- Daylight Savings Time Indicator
    ASHRAETau,               !- Solar Model Indicator
    ,                        !- Beam Solar Day Schedule Name
    ,                        !- Diffuse Solar Day Schedule Name
    0.544,                   !- taub (beam)
    1.787;                   !- taud (diffuse)

! =============================================================================
! SCHEDULE TYPE LIMITS
! =============================================================================

  ScheduleTypeLimits,
    Fraction,                !- Name
    0.0,                     !- Lower Limit Value
    1.0,                     !- Upper Limit Value
    CONTINUOUS;              !- Numeric Type

  ScheduleTypeLimits,
    On/Off,                  !- Name
    0,                       !- Lower Limit Value
    1,                       !- Upper Limit Value
    DISCRETE;                !- Numeric Type

  ScheduleTypeLimits,
    Temperature,             !- Name
    -60,                     !- Lower Limit Value
    200,                     !- Upper Limit Value
    CONTINUOUS,              !- Numeric Type
    Temperature;             !- Unit Type

  ScheduleTypeLimits,
    AnyNumber;               !- Name

! =============================================================================
! SCHEDULES
! Baseline: no DDC optimization — simple fixed setpoints, lights always on
! during business hours. ECM-2 will modify these.
! =============================================================================

  ! Always on (1.0)
  Schedule:Compact,
    Always On,               !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 1.0;

  ! Office occupancy: Mon-Fri 7am-6pm, minimal after hours
  Schedule:Compact,
    OFFICE_Occ_Sch,          !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 0.00,
    Until: 08:00, 0.25,
    Until: 17:00, 1.00,
    Until: 18:00, 0.50,
    Until: 24:00, 0.05,
    For: Saturday,
    Until: 08:00, 0.00,
    Until: 13:00, 0.20,
    Until: 24:00, 0.00,
    For: Sunday,
    Until: 24:00, 0.00;

  ! Lobby occupancy: extended hours, weekends moderate
  Schedule:Compact,
    LOBBY_Occ_Sch,           !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 0.05,
    Until: 18:00, 0.75,
    Until: 21:00, 0.40,
    Until: 24:00, 0.05,
    For: Weekend,
    Until: 09:00, 0.05,
    Until: 18:00, 0.35,
    Until: 24:00, 0.05;

  ! Office lighting: BASELINE — T8 fluorescents, simple on/off
  ! (ECM-1 will reduce Watts/Area, not change this schedule)
  Schedule:Compact,
    OFFICE_Lighting_Sch,     !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 0.05,      !- Emergency/security lighting
    Until: 18:00, 1.00,      !- Full operation — no daylight control in baseline
    Until: 24:00, 0.05,
    For: Saturday,
    Until: 08:00, 0.05,
    Until: 14:00, 0.50,
    Until: 24:00, 0.05,
    For: Sunday,
    Until: 24:00, 0.05;

  ! Lobby lighting
  Schedule:Compact,
    LOBBY_Lighting_Sch,      !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: AllDays,
    Until: 06:00, 0.20,
    Until: 07:00, 0.60,
    Until: 21:00, 1.00,
    Until: 22:00, 0.60,
    Until: 24:00, 0.20;

  ! Office equipment (plug loads)
  Schedule:Compact,
    OFFICE_Equip_Sch,        !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 0.10,
    Until: 08:00, 0.50,
    Until: 17:00, 1.00,
    Until: 18:00, 0.50,
    Until: 24:00, 0.10,
    For: Weekend,
    Until: 24:00, 0.10;

  ! Lobby equipment
  Schedule:Compact,
    LOBBY_Equip_Sch,         !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 0.10,
    Until: 21:00, 0.60,
    Until: 24:00, 0.10,
    For: Weekend,
    Until: 24:00, 0.20;

  ! HVAC availability — baseline: always available (no scheduling optimization)
  ! ECM-2 will add optimal start/stop here
  Schedule:Compact,
    HVAC_Avail_Sch,          !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 1.0;

  ! Heating setpoints — BASELINE: fixed 70°F (21.1°C) all hours
  ! No setback in baseline (ECM-2 will add night setback)
  Schedule:Compact,
    OFFICE_HtgSetpt_Sch,     !- Name
    Temperature,             !- Schedule Type Limits Name
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 21.1;      !- 70°F constant — no setback in baseline

  Schedule:Compact,
    LOBBY_HtgSetpt_Sch,      !- Name
    Temperature,             !- Schedule Type Limits Name
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 20.0;      !- 68°F lobby

  ! Cooling setpoints — BASELINE: fixed 75°F (23.9°C) all hours
  ! No setup in baseline (ECM-2 will add night setup)
  Schedule:Compact,
    OFFICE_ClgSetpt_Sch,     !- Name
    Temperature,             !- Schedule Type Limits Name
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 23.9;      !- 75°F constant — no setup in baseline

  Schedule:Compact,
    LOBBY_ClgSetpt_Sch,      !- Name
    Temperature,             !- Schedule Type Limits Name
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 25.0;      !- 77°F lobby (slightly warmer acceptable)

  ! Infiltration schedule — reduced when HVAC on (pressurization effect)
  Schedule:Compact,
    Infil_Sch,               !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 1.00,
    Until: 18:00, 0.25,      !- Building pressurized when occupied
    Until: 24:00, 1.00,
    For: Weekend,
    Until: 24:00, 1.00;

! =============================================================================
! MATERIALS AND CONSTRUCTIONS
! Zone 4A compliance: ASHRAE 90.1-2004
! =============================================================================

  ! Roof layers: metal deck + polyisocyanurate insulation + membrane
  Material,
    Roof Deck,               !- Name
    Smooth,                  !- Roughness
    0.0015,                  !- Thickness {m} — metal deck, thin
    45.0,                    !- Conductivity {W/m-K}
    7800,                    !- Density {kg/m3}
    418,                     !- Specific Heat {J/kg-K}
    0.9,                     !- Thermal Absorptance
    0.7,                     !- Solar Absorptance
    0.7;                     !- Visible Absorptance

  Material,
    Roof Insulation R25,     !- Name
    Rough,                   !- Roughness
    0.090,                   !- Thickness {m} — polyiso, gives ~R-25 US
    0.022,                   !- Conductivity {W/m-K}
    32,                      !- Density {kg/m3}
    1000,                    !- Specific Heat {J/kg-K}
    0.9, 0.7, 0.7;

  ! Exterior wall: CMU + continuous insulation (typical municipal)
  Material,
    CMU Wall,                !- Name
    MediumRough,             !- Roughness
    0.200,                   !- Thickness {m} — 8" CMU
    0.51,                    !- Conductivity {W/m-K}
    800,                     !- Density {kg/m3}
    920,                     !- Specific Heat {J/kg-K}
    0.9, 0.7, 0.7;

  Material,
    Wall Insulation R7.5ci,  !- Name
    Rough,                   !- Roughness
    0.033,                   !- Thickness {m} — polyiso ci, ~R-7.5 US
    0.022,                   !- Conductivity {W/m-K}
    32,                      !- Density {kg/m3}
    1000,                    !- Specific Heat {J/kg-K}
    0.9, 0.7, 0.7;

  ! Interior wall (between zones) — lightweight partition
  Material,
    Interior Partition,      !- Name
    Smooth,                  !- Roughness
    0.013,                   !- Thickness {m} — drywall
    0.16,                    !- Conductivity {W/m-K}
    800,                     !- Density {kg/m3}
    840,                     !- Specific Heat {J/kg-K}
    0.9, 0.6, 0.6;

  ! Slab on grade
  Material,
    Concrete Slab,           !- Name
    MediumRough,             !- Roughness
    0.150,                   !- Thickness {m} — 6" slab
    1.73,                    !- Conductivity {W/m-K}
    2200,                    !- Density {kg/m3}
    900,                     !- Specific Heat {J/kg-K}
    0.9, 0.7, 0.7;

  ! Constructions
  Construction,
    Roof Construction,       !- Name
    Roof Deck,               !- Layer 1 (outside)
    Roof Insulation R25;     !- Layer 2 (inside)

  Construction,
    Exterior Wall,           !- Name
    CMU Wall,                !- Layer 1 (outside)
    Wall Insulation R7.5ci;  !- Layer 2 (inside)

  Construction,
    Interior Wall,           !- Name
    Interior Partition;      !- Single layer

  Construction,
    Floor Slab,              !- Name
    Concrete Slab;           !- Single layer

  ! Window construction: double pane low-e (U~2.0 W/m2K, SHGC~0.40)
  WindowMaterial:SimpleGlazingSystem,
    Double Pane Low-E,       !- Name
    2.047,                   !- U-Factor {W/m2-K}
    0.40,                    !- Solar Heat Gain Coefficient
    0.60;                    !- Visible Transmittance

  Construction,
    Window Construction,     !- Name
    Double Pane Low-E;       !- Layer

