! =============================================================================
! HVAC — HVACTemplate: Packaged RTU per zone
! Gas furnace + single-speed DX cooling
! Baseline: no economizer, fixed setpoints, constant fan
! ECM-2 will modify thermostat schedules for setback/setup
! =============================================================================

  ! --- OUTDOOR AIR DESIGN SPECIFICATIONS ---

  DesignSpecification:OutdoorAir,
    OFFICE OA Spec,          !- Name
    Sum,                     !- Outdoor Air Method
    0.00944,                 !- Outdoor Air Flow per Person {m3/s-person} = 15 cfm/person
    0.000305,                !- Outdoor Air Flow per Zone Floor Area {m3/s-m2} = 0.06 cfm/sf
    ,,,;

  DesignSpecification:OutdoorAir,
    LOBBY OA Spec,           !- Name
    Sum,
    0.00944,                 !- 15 cfm/person
    0.000305,                !- 0.06 cfm/sf
    ,,,;
! 
!   ! --- THERMOSTATS ---
! 
!   HVACTemplate:Thermostat,
!     OFFICE Thermostat,       !- Name
!     OFFICE_HtgSetpt_Sch,     !- Heating Setpoint Temperature Schedule Name
!     ,                        !- Constant Heating Setpoint — use schedule instead
!     OFFICE_ClgSetpt_Sch,     !- Cooling Setpoint Temperature Schedule Name
!     ;                        !- Constant Cooling Setpoint
! 
!   HVACTemplate:Thermostat,
!     LOBBY Thermostat,        !- Name
!     LOBBY_HtgSetpt_Sch,
!     ,
!     LOBBY_ClgSetpt_Sch,
!     ;
! 
!   ! --- ZONE UNITARY SYSTEMS (PSZ-AC per zone) ---
!   ! Field order per EnergyPlus 25.1 IDD: Zone, System, Thermostat, MaxFlow,
!   !   HtgFactor, ClgFactor, OA Method, OA/person, OA/area, OA/zone
! 
!   HVACTemplate:Zone:Unitary,
!     OFFICE,                  !- Zone Name
!     OFFICE RTU,              !- Template Unitary System Name
!     OFFICE Thermostat,       !- Template Thermostat Name
!     autosize,                !- Supply Air Maximum Flow Rate {m3/s}
!     ,                        !- Zone Heating Sizing Factor
!     ,                        !- Zone Cooling Sizing Factor
!     Flow/Person,             !- Outdoor Air Method
!     0.00944,                 !- Outdoor Air Flow Rate per Person {m3/s} (20 cfm)
!     ,                        !- Outdoor Air Flow Rate per Zone Floor Area
!     ;                        !- Outdoor Air Flow Rate per Zone
! 
!   HVACTemplate:Zone:Unitary,
!     LOBBY,                   !- Zone Name
!     LOBBY RTU,               !- Template Unitary System Name
!     LOBBY Thermostat,        !- Template Thermostat Name
!     autosize,                !- Supply Air Maximum Flow Rate {m3/s}
!     ,                        !- Zone Heating Sizing Factor
!     ,                        !- Zone Cooling Sizing Factor
!     Flow/Person,             !- Outdoor Air Method
!     0.00944,                 !- Outdoor Air Flow Rate per Person {m3/s} (20 cfm)
!     ,                        !- Outdoor Air Flow Rate per Zone Floor Area
!     ;                        !- Outdoor Air Flow Rate per Zone
! 
!   ! --- PACKAGED UNITARY SYSTEMS ---
!   ! Field order per EnergyPlus 25.1 IDD:
!   !   Name, Avail Sched, Control Zone, Fan Max Flow, Fan Op Mode Sched,
!   !   Fan Eff, Fan dP, Fan Motor Eff, Fan Motor Frac,
!   !   Clg Coil Type, Clg Avail Sched, Clg SAT, Clg Cap, Clg SHR, Clg COP,
!   !   Htg Coil Type, Htg Avail Sched, Htg SAT, Htg Cap, Gas Eff, Gas Parasite,
!   !   Max OA, Min OA, Min OA Sched, Economizer, Lockout, ...
!   !   Supply Plenum, Return Plenum, Fan Placement, Night Cycle, ...
! 
!   HVACTemplate:System:Unitary,
!     OFFICE RTU,              !- Name
!     HVAC_Avail_Sch,          !- System Availability Schedule Name
!     OFFICE,                  !- Control Zone or Thermostat Location Name
!     autosize,                !- Supply Fan Maximum Flow Rate {m3/s}
!     Always On,               !- Supply Fan Operating Mode Schedule Name
!     0.70,                    !- Supply Fan Total Efficiency
!     745.0,                   !- Supply Fan Delta Pressure {Pa}
!     0.90,                    !- Supply Fan Motor Efficiency
!     1.0,                     !- Supply Fan Motor in Air Stream Fraction
!     SingleSpeedDX,           !- Cooling Coil Type
!     ,                        !- Cooling Coil Availability Schedule Name
!     12.8,                    !- Cooling Design Supply Air Temperature {C}
!     autosize,                !- Cooling Coil Gross Rated Total Capacity {W}
!     autosize,                !- Cooling Coil Gross Rated Sensible Heat Ratio
!     3.50,                    !- Cooling Coil Gross Rated COP
!     Gas,                     !- Heating Coil Type
!     ,                        !- Heating Coil Availability Schedule Name
!     50.0,                    !- Heating Design Supply Air Temperature {C}
!     autosize,                !- Heating Coil Capacity {W}
!     0.80,                    !- Gas Heating Coil Efficiency
!     0,                       !- Gas Heating Coil Parasitic Electric Load {W}
!     autosize,                !- Maximum Outdoor Air Flow Rate {m3/s}
!     autosize,                !- Minimum Outdoor Air Flow Rate {m3/s}
!     ,                        !- Minimum Outdoor Air Schedule Name
!     NoEconomizer,            !- Economizer Type
!     NoLockout,               !- Economizer Lockout
!     ,                        !- Economizer Upper Temperature Limit {C}
!     ,                        !- Economizer Lower Temperature Limit {C}
!     ,                        !- Economizer Upper Enthalpy Limit {J/kg}
!     ,                        !- Economizer Maximum Limit Dewpoint Temperature {C}
!     ,                        !- Supply Plenum Name
!     ,                        !- Return Plenum Name
!     BlowThrough,             !- Supply Fan Placement
!     StayOff,                 !- Night Cycle Control
!     ,                        !- Night Cycle Control Zone Name
!     None,                    !- Heat Recovery Type
!     ,                        !- Sensible Heat Recovery Effectiveness
!     ;                        !- Latent Heat Recovery Effectiveness
! 
!   HVACTemplate:System:Unitary,
!     LOBBY RTU,               !- Name
!     HVAC_Avail_Sch,          !- System Availability Schedule Name
!     LOBBY,                   !- Control Zone or Thermostat Location Name
!     autosize,                !- Supply Fan Maximum Flow Rate {m3/s}
!     Always On,               !- Supply Fan Operating Mode Schedule Name
!     0.70,                    !- Supply Fan Total Efficiency
!     745.0,                   !- Supply Fan Delta Pressure {Pa}
!     0.90,                    !- Supply Fan Motor Efficiency
!     1.0,                     !- Supply Fan Motor in Air Stream Fraction
!     SingleSpeedDX,           !- Cooling Coil Type
!     ,                        !- Cooling Coil Availability Schedule Name
!     12.8,                    !- Cooling Design Supply Air Temperature {C}
!     autosize,                !- Cooling Coil Gross Rated Total Capacity {W}
!     autosize,                !- Cooling Coil Gross Rated Sensible Heat Ratio
!     3.50,                    !- Cooling Coil Gross Rated COP
!     Gas,                     !- Heating Coil Type
!     ,                        !- Heating Coil Availability Schedule Name
!     50.0,                    !- Heating Design Supply Air Temperature {C}
!     autosize,                !- Heating Coil Capacity {W}
!     0.80,                    !- Gas Heating Coil Efficiency
!     0,                       !- Gas Heating Coil Parasitic Electric Load {W}
!     autosize,                !- Maximum Outdoor Air Flow Rate {m3/s}
!     autosize,                !- Minimum Outdoor Air Flow Rate {m3/s}
!     ,                        !- Minimum Outdoor Air Schedule Name
!     NoEconomizer,            !- Economizer Type
!     NoLockout,               !- Economizer Lockout
!     ,                        !- Economizer Upper Temperature Limit {C}
!     ,                        !- Economizer Lower Temperature Limit {C}
!     ,                        !- Economizer Upper Enthalpy Limit {J/kg}
!     ,                        !- Economizer Maximum Limit Dewpoint Temperature {C}
!     ,                        !- Supply Plenum Name
!     ,                        !- Return Plenum Name
!     BlowThrough,             !- Supply Fan Placement
!     StayOff,                 !- Night Cycle Control
!     ,                        !- Night Cycle Control Zone Name
!     None,                    !- Heat Recovery Type
!     ,                        !- Sensible Heat Recovery Effectiveness
!     ;                        !- Latent Heat Recovery Effectiveness

! =============================================================================
! OUTPUT VARIABLES AND METERS
! Monthly resolution for M&V analysis
! Annual/hourly also available for model diagnostics
! =============================================================================

  OutputControl:Table:Style,
    CommaAndHTML;            !- Column Separator

  Output:Table:SummaryReports,
    AllSummary;              !- Report Name 1

  ! Energy meters — monthly for M&V analysis
  Output:Meter,
    Electricity:Facility,    !- Key Name
    Monthly;                 !- Reporting Frequency

  Output:Meter,
    NaturalGas:Facility,     !- Key Name
    Monthly;

  Output:Meter,
    Cooling:Electricity,     !- Key Name
    Monthly;

  Output:Meter,
    Heating:NaturalGas,      !- Key Name
    Monthly;

  Output:Meter,
    InteriorLights:Electricity,  !- Key Name
    Monthly;

  Output:Meter,
    InteriorEquipment:Electricity,
    Monthly;

  Output:Meter,
    Fans:Electricity,
    Monthly;

  ! Zone-level variables — monthly for baseline characterization
  Output:Variable,
    OFFICE,                  !- Key Value
    Zone Mean Air Temperature,
    Monthly;

  Output:Variable,
    LOBBY,
    Zone Mean Air Temperature,
    Monthly;

  Output:Variable,
    *,                       !- All zones
    Site Outdoor Air Drybulb Temperature,
    Monthly;

  Output:Variable,
    *,
    Zone Mechanical Ventilation Current Density Volume Flow Rate,
    Monthly;

  ! Hourly outputs for diagnostic / scatter plot generation
  Output:Meter,
    Electricity:Facility,
    Hourly;

  Output:Meter,
    NaturalGas:Facility,
    Hourly;

  Output:Variable,
    *,
    Site Outdoor Air Drybulb Temperature,
    Hourly;

  ! Simulation diagnostics
  Output:Diagnostics,
    DisplayUnusedSchedules;

  Output:SQLite,
    SimpleAndTabular;        !- Output Type
! 
