! =============================================================================
! INTERNAL GAINS — People, Lights, Equipment
! =============================================================================

  ! --- PEOPLE ---

  People,
    OFFICE People,           !- Name
    OFFICE,                  !- Zone or ZoneList or Space or SpaceList Name
    OFFICE_Occ_Sch,          !- Number of People Schedule Name
    People/Area,             !- Number of People Calculation Method
    ,                        !- Number of People
    0.053763,                !- People per Zone Floor Area {person/m2} = 5/1000sf
    ,                        !- Zone Floor Area per Person
    0.3,                     !- Fraction Radiant
    ,                        !- Sensible Heat Fraction
    Activity Sch;            !- Activity Level Schedule Name

  Schedule:Compact,
    Activity Sch,            !- Name
    AnyNumber,               !- Schedule Type Limits Name
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 120.0;    !- 120 W/person (office work)

  People,
    LOBBY People,            !- Name
    LOBBY,                   !- Zone Name
    LOBBY_Occ_Sch,           !- Number of People Schedule Name
    People/Area,             !- Number of People Calculation Method
    ,                        !- Number of People
    0.107527,                !- People per Zone Floor Area {person/m2} = 10/1000sf
    ,
    0.3,                     !- Fraction Radiant
    ,                        !- Sensible Heat Fraction
    Activity Sch;

  ! --- LIGHTS ---

  ! OFFICE: T8 FLUORESCENT BASELINE — 1.5 W/sf = 16.15 W/m²
  ! ECM-1 target: LED at 0.75 W/sf (50% reduction)
  ! NOTE: modify_lights tool targets this object for ECM-1 demo
  Lights,
    OFFICE Lights,           !- Name
    OFFICE,                  !- Zone or ZoneList or Space or SpaceList Name
    OFFICE_Lighting_Sch,     !- Schedule Name
    Watts/Area,              !- Design Level Calculation Method
    ,                        !- Lighting Level {W}
    8.07,                    !- Watts per Zone Floor Area {W/m2} — LED ECM-1 + setback ECM-2
    ,                        !- Watts per Person
    0.42,                    !- Return Air Fraction — fluorescent heat to return air
    0.09,                    !- Fraction Radiant — T8 fluorescent
    0.18,                    !- Fraction Visible
    1.00,                    !- Fraction Replaceable
    General,                 !- End-Use Subcategory
    No;                      !- Return Air Fraction Calculated from Plenum Temperature

  ! LOBBY: existing fixtures, not part of ECM-1 retrofit
  Lights,
    LOBBY Lights,            !- Name
    LOBBY,                   !- Zone Name
    LOBBY_Lighting_Sch,      !- Schedule Name
    Watts/Area,              !- Design Level Calculation Method
    ,
    10.76,                   !- Watts per Zone Floor Area {W/m2} — 1.0 W/sf, not retrofitted
    ,
    0.32,                    !- Return Air Fraction
    0.09,                    !- Fraction Radiant
    0.18,                    !- Fraction Visible
    1.00,                    !- Fraction Replaceable
    General,                 !- End-Use Subcategory
    No;

  ! --- ELECTRIC EQUIPMENT (plug loads) ---

  ElectricEquipment,
    OFFICE Equipment,        !- Name
    OFFICE,                  !- Zone Name
    OFFICE_Equip_Sch,        !- Schedule Name
    Watts/Area,              !- Design Level Calculation Method
    ,
    10.76,                   !- Watts per Zone Floor Area {W/m2} — 1.0 W/sf
    ,
    0.50,                    !- Fraction Latent
    0.00,                    !- Fraction Radiant (to zone air)
    0.00;                    !- Fraction Lost

  ElectricEquipment,
    LOBBY Equipment,         !- Name
    LOBBY,                   !- Zone Name
    LOBBY_Equip_Sch,         !- Schedule Name
    Watts/Area,
    ,
    5.38,                    !- Watts per Zone Floor Area {W/m2} — 0.5 W/sf
    ,
    0.50,
    0.00,
    0.00;

  ! --- INFILTRATION ---

  ZoneInfiltration:DesignFlowRate,
