    0.0,                     !- Direction of Relative North {deg}
    0.0, 0.0, 0.0,           !- Origin X, Y, Z {m}
    1,                       !- Type
    1,                       !- Multiplier
    3.048,                   !- Ceiling Height {m} — 10 ft
    2265.45;                 !- Volume {m3} = 743.22 m2 × 3.048 m

  Zone,
