    ,                        !- Flow per Zone Floor Area
    0.000305,                !- Flow per Exterior Surface Area {m3/s-m2} — 0.06 cfm/sf EWA
    ;                        !- Air Changes per Hour

  ZoneInfiltration:DesignFlowRate,
